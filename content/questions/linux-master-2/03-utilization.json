{
  "cert": "linux-master-2",
  "subject": "리눅스 활용",
  "note": "content/linux-master-2/03-utilization.md",
  "questions": [
    {"id": "ut-01", "topic": "X Window", "q": "X Window 시스템에서 X 서버의 역할은?", "c": ["네트워크 주소 할당", "응용 프로그램 실행", "화면 출력과 키보드·마우스 입력 처리", "파일 공유"], "a": 2, "e": "X 서버가 디스플레이와 입력 장치를 담당하고 X 클라이언트가 응용 프로그램입니다."},
    {"id": "ut-02", "topic": "X Window", "q": "다음 중 데스크톱 환경이 아닌 것은?", "c": ["GRUB", "KDE", "GNOME", "Xfce"], "a": 0, "e": "GRUB 은 부트 로더입니다."},
    {"id": "ut-03", "topic": "X Window", "q": "X 클라이언트가 출력할 X 서버를 지정하는 환경 변수는?", "c": ["DISPLAY", "SHELL", "XAUTH", "TERM"], "a": 0, "e": "DISPLAY=host:0.0 형식입니다."},
    {"id": "ut-04", "topic": "네트워크", "q": "IP 주소를 확인하는 최신 iproute2 명령은?", "c": ["arp", "ip addr", "ifconfig", "netstat -i"], "a": 1, "e": "ifconfig 는 net-tools 로 구형이며 ip addr(ip a)가 최신입니다."},
    {"id": "ut-05", "topic": "네트워크", "q": "DNS 서버 주소를 지정하는 파일은?", "c": ["/etc/hostname", "/etc/hosts", "/etc/services", "/etc/resolv.conf"], "a": 3, "e": "nameserver 항목으로 지정합니다."},
    {"id": "ut-06", "topic": "네트워크", "q": "호스트 이름과 IP 주소를 정적으로 매핑하는 파일은?", "c": ["/etc/nsswitch.conf", "/etc/protocols", "/etc/networks", "/etc/hosts"], "a": 3, "e": "nsswitch.conf 는 조회 순서를 정합니다."},
    {"id": "ut-07", "topic": "TCP Wrapper", "q": "TCP Wrapper 의 접근 제어 파일 검사 순서는?", "c": ["hosts.deny → hosts.allow", "hosts.allow 만 검사", "두 파일 동시 검사", "hosts.allow → hosts.deny"], "a": 3, "e": "allow 에서 일치하면 허용, 아니면 deny 를 확인하며 둘 다 일치하지 않으면 허용입니다."},
    {"id": "ut-08", "topic": "Apache", "q": "RHEL 계열에서 Apache 의 기본 문서 루트는?", "c": ["/srv/http/www", "/usr/share/apache", "/var/www/html", "/etc/httpd/html"], "a": 2, "e": "DocumentRoot \"/var/www/html\" 이 기본값입니다."},
    {"id": "ut-09", "topic": "Apache", "q": "Apache 설정 파일의 문법을 검사하는 명령은?", "c": ["httpd -x", "httpd -v", "httpd -k", "httpd -t"], "a": 3, "e": "apachectl configtest 도 같은 역할입니다."},
    {"id": "ut-10", "topic": "Samba", "q": "Samba 에서 파일·프린터 공유를 담당하는 데몬은?", "c": ["named", "winbindd", "nmbd", "smbd"], "a": 3, "e": "smbd 는 파일·인쇄 공유, nmbd 는 NetBIOS 이름 서비스입니다."},
    {"id": "ut-11", "topic": "NFS", "q": "NFS 서버의 공유 디렉터리를 설정하는 파일은?", "c": ["/etc/mtab", "/etc/fstab", "/etc/nfs.conf", "/etc/exports"], "a": 3, "e": "설정 후 exportfs -ra 로 반영합니다."},
    {"id": "ut-12", "topic": "FTP", "q": "vsftpd 에서 익명 사용자 접속 허용 여부를 설정하는 항목은?", "c": ["anonymous_enable", "write_enable", "chroot_local_user", "local_enable"], "a": 0, "e": "anonymous_enable=YES/NO 입니다."},
    {"id": "ut-13", "topic": "DNS", "q": "BIND 의 주 설정 파일은?", "c": ["/etc/named.conf", "/etc/bind.cfg", "/etc/resolv.conf", "/etc/dns.conf"], "a": 0, "e": "존 파일은 /var/named 아래에 둡니다."},
    {"id": "ut-14", "topic": "DNS", "q": "IP 주소로 도메인 이름을 조회하는 역방향 조회에 사용하는 레코드는?", "c": ["A", "MX", "CNAME", "PTR"], "a": 3, "e": "PTR 레코드는 in-addr.arpa 존에서 사용합니다."},
    {"id": "ut-15", "topic": "DHCP", "q": "ISC DHCP 서버의 설정 파일은?", "c": ["/etc/bootp.conf", "/etc/dhcp/dhcpd.conf", "/etc/dhclient.conf", "/etc/dhcpd.lease"], "a": 1, "e": "dhclient.conf 는 클라이언트 설정 파일입니다."},
    {"id": "ut-16", "topic": "메일", "q": "sendmail 의 /etc/aliases 를 수정한 뒤 변경을 반영하는 명령은?", "c": ["mailq", "newaliases", "sendmail -bp", "postmap"], "a": 1, "e": "newaliases 로 aliases.db 를 다시 생성합니다."},
    {"id": "ut-17", "topic": "SSH", "q": "SSH 서버에서 root 의 직접 로그인을 금지하는 설정은?", "c": ["PermitRootLogin no", "RootLogin deny", "AllowRoot no", "DenyUsers none"], "a": 0, "e": "/etc/ssh/sshd_config 에서 설정합니다."},
    {"id": "ut-18", "topic": "iptables", "q": "내부망 주소를 외부 인터페이스 주소로 변환(위장)하는 NAT 설정에 사용하는 체인은?", "c": ["FORWARD", "PREROUTING", "INPUT", "POSTROUTING"], "a": 3, "e": "iptables -t nat -A POSTROUTING -o eth0 -j MASQUERADE 입니다."},
    {"id": "ut-19", "topic": "iptables", "q": "iptables 에서 INPUT 체인의 기본 정책을 DROP 으로 설정하는 옵션은?", "c": ["-F", "-P", "-A", "-D"], "a": 1, "e": "-A 추가, -D 삭제, -P 기본 정책, -F 전체 삭제입니다."},
    {"id": "ut-20", "topic": "SELinux", "q": "현재 SELinux 동작 모드를 확인하는 명령은?", "c": ["getenforce", "restorecon", "chcon", "setenforce"], "a": 0, "e": "setenforce 0|1 로 permissive/enforcing 을 전환합니다."},
    {"id": "ut-21", "topic": "프록시", "q": "Squid 프록시 서버의 기본 포트는?", "c": ["80", "8443", "3128", "8000"], "a": 2, "e": "Squid 기본 포트는 3128 입니다."},
    {"id": "ut-22", "topic": "프린터", "q": "리눅스의 인쇄 시스템 CUPS 가 사용하는 포트는?", "c": ["3306", "515", "9100", "631"], "a": 3, "e": "CUPS 는 IPP 기반으로 631 포트를 사용합니다."}
  ]
